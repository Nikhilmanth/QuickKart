# QuickKart environment configuration
# Razorpay TEST keys (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Phone-Auth SMS OTP (from Firebase console -> Project settings)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_APP_ID=your_firebase_app_id

# Admin panel access — login with OTP on this phone number or email
ADMIN_PHONE=your_admin_phone_number
ADMIN_EMAIL=your_admin_email@example.com

# JWT & Port
JWT_SECRET=your_jwt_secret_key_here
PORT=4000

# Email configuration for sending OTP via email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="QuickKart" <your_email@gmail.com>
